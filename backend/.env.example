# Copy to backend/.env and fill in. Never commit .env.
PORT=5050

# Jev (TypeSafe AI). Leave blank to use the regex rules instead.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BACKUP_MODEL=gemini-flash-lite-latest

# Leave ACCOUNT or PAT blank to keep history/settings in memory instead.
# Account identifier, e.g. myorg-myaccount (the part before .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=
# Programmatic access token printed by snowflake/04_access.sql
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=CONNIE_APP
SNOWFLAKE_WAREHOUSE=CONNIE_WH
SNOWFLAKE_DATABASE=CONNIE
SNOWFLAKE_SCHEMA=APP
# History search: "vector" (Snowflake VECTOR + Gemini embeddings; works on trial
# accounts) or "cortex" (Cortex Search + COMPLETE; needs Snowflake AI features).
SNOWFLAKE_SEARCH=vector
# Cortex model, only used when SNOWFLAKE_SEARCH=cortex.
SNOWFLAKE_LLM=mistral-large2
