{
  "manifest_version": 3,
  "name": "Connie — mindful AI helper",
  "version": "0.2.0",
  "description": "Connie holds files you're about to share with an AI tool, checks them for personal data, and helps you decide.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:5050/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5050/demo/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "connie-ui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "connie.css"
      ],
      "matches": [
        "http://localhost:5050/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Connie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
